<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nico.minidpc"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="34" />

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:label="MinimalDPC" >

        <!--
             MainActivity has NO LAUNCHER intent filter on purpose:
             the app does not appear in the app drawer.
             To open it: adb shell am start -n com.nico.minidpc/.MainActivity
        -->
        <activity
            android:name="com.nico.minidpc.MainActivity"
            android:exported="true" />

        <receiver
            android:name="com.nico.minidpc.AdminReceiver"
            android:exported="true"
            android:label="MinimalDPC"
            android:permission="android.permission.BIND_DEVICE_ADMIN" >
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />

            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>